# Scatter Plots

people = ["Person A","Person B","Person C","Person D","Person E",
         "Person F","Person G","Person H","Person I","Person J",]

age = [22, 25, 30, 35, 40, 45, 50, 55, 60, 65]
bp = [110, 115, 120, 122, 125, 130, 135, 123, 145, 150]

# Blood Pressure = 120 is considered Normal


color = ["green" if x < 135 else "red" for x in bp]



# plt.scatter(age, bp, color=color, s=bp, alpha=0.3)
plt.scatter(age, bp, s=bp, cmap="OrRd", c=bp)

plt.title("AGE VS BP")
plt.xlabel("Age")
plt.ylabel("Blood Pressure")
plt.colorbar()

# Annotate
for i in range(len(people)):
    plt.annotate(people[i], xy=(age[i], bp[i]), xytext=(age[i], bp[i]-1))

plt.xlim(min(age), max(age)+5)
plt.ylim(min(bp)-10, max(bp)+5)


