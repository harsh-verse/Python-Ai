# Weekly Temp Project

days = ["Mon", "Tue", "Wed", "Thu", "Fri", ]

cities = ["New York", "London", "Delhi", "Tokyo"]

temperature = [
    [22, 23, 21, 24, 25],   #New York
    [18, 19, 17, 20, 21],   #London
    [30, 32, 31, 33, 34],   #Delhi
    [25, 26, 24, 27, 28]    #Tokyo
]

fig, axes = plt.subplots(2, 2)

# city_no = 0

# for i in range(2):# rows (i) -- 0, 1
#     for j in range(2): # columns (j) -- 0, 1
#         axes[i][j].plot(days, temperature[city_no], marker="o")
#         axes[i][j].set_title(cities[city_no])
#         axes[i][j].grid(True)
        # city_no = city_no + 1


# Converting this 2D array into 1D array and use single loop to do this same task and to convert it into 1D array we use flatten()
# Enumerate () returns the index and value 

axes = axes.flatten()
for i,ax in enumerate(axes):
    ax.plot(days, temperature[i], marker='o')
    ax.set_title(cities[i])
    ax.grid(True)


        

fig.suptitle("Temperature in Cities over the week")
fig.supylabel("Temperature")
fig.supxlabel("Days")
fig.tight_layout()



