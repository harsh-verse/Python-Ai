# Histogram

import numpy as np
import matplotlib.pyplot as plt

np.random.seed(0)

scores=np.random.normal(70, 10, 100)  #Normal distribution

bins = [0, 30, 70, 90, 100]


plt.hist(scores, color="skyblue", edgecolor="black", bins=bins)

plt.axvline(
    x=33,
    label="Passing marks",
    color="red",
    linewidth=2,
    linestyle="--"
    
)


plt.ylabel("No of students")
plt.xlabel("Scores")
print(scores)


